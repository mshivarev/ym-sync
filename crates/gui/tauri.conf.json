{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ym-sync",
  "version": "0.2.0",
  "identifier": "dev.mshiv.ymsync",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "ym-sync",
        "width": 1200,
        "height": 800,
        "minWidth": 760,
        "minHeight": 540,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https://avatars.yandex.net"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVFNkM4N0Y0RjUxM0E4MjgKUldRb3FCUDE5SWRzWGpNZFk5U2ljbjdwOFNoOFcvdDJWWGV2ejJuTDRpS01PNzNxQ3cyK1JuUFYK",
      "endpoints": [
        "https://github.com/mshivarev/ym-sync/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
