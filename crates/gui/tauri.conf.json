{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ym-sync",
  "version": "0.1.0",
  "identifier": "dev.mshiv.ymsync",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "ym-sync",
        "width": 1000,
        "height": 720,
        "minWidth": 760,
        "minHeight": 540,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
